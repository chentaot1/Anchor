root = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 160

# Jetpack Compose functions are conventionally PascalCase (e.g. @Composable fun HomeScreen())
ktlint_standard_function-naming = disabled
ktlint_standard_max-line-length = 160
ktlint_standard_package-name = disabled
